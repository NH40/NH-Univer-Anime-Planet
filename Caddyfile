# {$DOMAIN} — авто-HTTPS через Let's Encrypt по этому домену (см. .env: DOMAIN=).
# Один хост отдаёт и статику фронтенда, и картинки карточек, и проксирует /api на
# FastAPI — same-origin, поэтому CORS в api/main.py не понадобился в проде.
{$DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /cards/* {
		uri strip_prefix /cards
		root * /srv/cards
		# Картинки карточек не меняются после заливки (см. seed_cards.py — upsert по пути,
		# не по содержимому) — долгий Cache-Control убирает повторную загрузку при возврате
		# на экран коллекции/пролистывании страниц, это НЕ чинит первую загрузку (см. CLAUDE.md).
		header Cache-Control "public, max-age=2592000, immutable"
		file_server
	}

	handle {
		root * /srv/web
		# index.html (и SPA-фоллбэк try_files) — всегда без кэша: иначе после редеплоя
		# Telegram WebView/браузер продолжает открывать старую HTML-страницу со ссылкой на
		# старый хэшированный JS-бандл, и новый код фронтенда не подхватывается без ручного
		# сброса кэша клиента (наступили на это 2026-08-11). Файлы в /assets/* от Vite
		# хэшируются по содержимому — им, наоборот, можно кэшироваться агрессивно и долго,
		# смена контента = новое имя файла, никогда не отдаст устаревшее.
		header Cache-Control "no-cache"
		@hashed_assets path /assets/*
		header @hashed_assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# Второй сайт в ЭТОМ ЖЕ Caddyfile — LookismBattlePlanet (сосед по серверу, отдельный
# docker-compose проект). Caddy умеет несколько site-блоков в одном Caddyfile из коробки
# (свой авто-HTTPS сертификат на каждый домен) — заводить второй Caddy-контейнер не
# нужно и нельзя (см. docker-compose.yml, "два Caddy не могут слушать 80/443
# одновременно"). `lookism_api`/`lookism_web` резолвятся по имени контейнера ТОЛЬКО
# потому что этот `caddy`-сервис и они оба состоят в общей внешней сети `edge` (см.
# docker-compose.yml, `networks.edge`, и LBP CLAUDE.md "Mini App: постоянный домен") —
# без этой сети имя контейнера из чужого docker-compose проекта было бы недостижимо.
lbp.universanimeplanet.ru {
	encode gzip

	handle /api/* {
		reverse_proxy lookism_api:8000
	}

	handle {
		reverse_proxy lookism_web:80
	}
}
