# --- Telegram ---
BOT_TOKEN=123456:ABC-your-telegram-bot-token
# Comma-separated Telegram user IDs with admin access to /admin
ADMIN_IDS=

# --- Postgres ---
POSTGRES_USER=uap
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uap
# Used by the bot process (host name matches the docker-compose service name)
DATABASE_URL=postgresql+asyncpg://uap:change-me@postgres:5432/uap

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- ЮKassa ---
# provider_token, который выдаёт BotFather после подключения ЮKassa в разделе Payments
# (Bot Settings -> Payments -> ЮKassa) — это НЕ shop_id/secret_key с сайта ЮKassa напрямую.
# Формат обычно вида "381764678:TEST:181121" (TEST-токен для тестовых платежей без списания денег).
YOOKASSA_PROVIDER_TOKEN=

# --- Misc ---
LOG_LEVEL=INFO
# Timezone used for season/war timestamps shown to players
TZ=Europe/Moscow

# --- Mini App (см. TODO, Этап 12) ---
# Домен, указывающий на этот сервер (A-запись) — обязателен для Caddy (авто-HTTPS через
# Let's Encrypt выдаётся по домену, не по IP). Пока домена нет — оставьте пустым, сервис
# caddy тогда просто не поднимайте (docker compose up -d bot postgres redis).
DOMAIN=
# https://<DOMAIN> — используется ботом для кнопки "Коллекция (веб)" в главном меню.
# Пусто -> кнопка не показывается.
MINI_APP_URL=
