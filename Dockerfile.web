# Мульти-стейдж: собираем статику Vite-фронтенда в node-образе, но в финальном образе
# остаётся только caddy + готовые файлы — без node_modules и тулчейна сборки в проде.
FROM node:20-alpine AS build
WORKDIR /app
# npm ci по lock-файлу: `npm install` без него падал на сервере («reading 'edgesOut'», 2026-10-20).
COPY src/web/package.json src/web/package-lock.json ./
RUN npm ci
COPY src/web/ ./
RUN npm run build

FROM caddy:2-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv/web
